    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-query": "^5.80.0",
    "antd": "^5.25.0",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
