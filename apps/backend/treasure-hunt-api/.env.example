# Local development settings. Copy to .env (npm scripts load it automatically).
STAGE=local
SERVICE_NAME=treasure-hunt-api
PORT=4002
TABLE_NAME=lkdr-treasure-hunt
PLATFORM_TABLE_NAME=lkdr-platform
DYNAMODB_ENDPOINT=http://localhost:8100
SECRETS_SOURCE=env
# Must match the platform API, which signs the cookies
SESSION_SECRET=local-session-secret-change-me-32chars
ADMIN_SECRET=local-admin-secret-change-me-32chars!
# QuickLook Leaderboard API (the QuickLook mock locally). In AWS these come from SSM
LEADERBOARD_BASE_URL=http://localhost:4010
LEADERBOARD_API_KEY=local-leaderboard-key
# Read open sessions every 5 seconds locally, so tests are quick (AWS uses 15)
SYNC_SECONDS=5
