# Local development settings. Copy to .env (npm scripts load it automatically).
STAGE=local
SERVICE_NAME=treasure-hunt-api
PORT=4002
TABLE_NAME=lkdr-treasure-hunt
PLATFORM_TABLE_NAME=lkdr-platform
DYNAMODB_ENDPOINT=http://localhost:8100
SECRETS_SOURCE=env
# Must match the platform API, which signs the cookies
SESSION_SECRET=local-session-secret-change-me-32chars
ADMIN_SECRET=local-admin-secret-change-me-32chars!
# Opens QuickLook's scan messages. Local test key only. In AWS: SSM /lkdr/{stage}/hunt/scan-key
HUNT_SCAN_KEY=ee8c38dc120c2b6ecd6e6144055571bd54876ab47608d9da0e6a8f33f0f561d7
SCAN_MAX_AGE_SECONDS=300
# Winners are worked out this long after the end (AWS: 30 seconds), short locally for quick tests
FINALIZE_GRACE_SECONDS=2
# Finalize ended sessions every 5 seconds locally, so tests are quick (AWS runs every minute)
JOB_SECONDS=5
