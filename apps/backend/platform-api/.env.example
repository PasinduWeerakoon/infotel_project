# Local development settings. Copy to .env (npm scripts load it automatically).
STAGE=local
SERVICE_NAME=platform-api
PORT=4000
TABLE_NAME=lkdr-platform
DYNAMODB_ENDPOINT=http://localhost:8100
COOKIE_SECURE=false

# QuickLook mock (apps/backend/quicklook-mock)
QL_ISSUER=http://localhost:4010
QL_API_BASE=http://localhost:4010
QL_CLIENT_ID=lkdr-local
QL_CLIENT_SECRET=local-client-secret
QL_WEBHOOK_SECRETS=test_secret_do_not_use_in_production

# Visitor apps (Vite dev servers)
GAMES_WEB_URL=http://localhost:5173
HUNT_WEB_URL=http://localhost:5174

# No event bus locally, so scan events are not published
EVENTS_MODE=http

# Images are stored by this dev server
ASSETS_MODE=local
ASSETS_BASE_URL=http://localhost:4000/_local/assets

# Secrets (local only). In AWS these come from SSM Parameter Store.
SECRETS_SOURCE=env
SESSION_SECRET=local-session-secret-change-me-32chars
ADMIN_SECRET=local-admin-secret-change-me-32chars!
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe2026

# QuickLook partner link key (`?qUser=` on logo links). Local test key only, the QuickLook mock
# makes links with it. In AWS the real key is in SSM: /lkdr/{stage}/quicklook/partner-link-key
PARTNER_LINK_KEY=53c8fc830852a660731bcc69ce8641be6da48dd75be61d201b1eb48edbed705e
PARTNER_LINK_MAX_AGE_SECONDS=300
