# Local development settings. Copy to .env (npm scripts load it automatically).
STAGE=local
SERVICE_NAME=games-event-api
PORT=4001
TABLE_NAME=lkdr-games-event
PLATFORM_TABLE_NAME=lkdr-platform
DYNAMODB_ENDPOINT=http://localhost:8100
ASSETS_BASE_URL=http://localhost:4000/_local/assets
SCREENS_MODE=local
SECRETS_SOURCE=env
# Must match the platform API, which signs the cookies
SESSION_SECRET=local-session-secret-change-me-32chars
ADMIN_SECRET=local-admin-secret-change-me-32chars!
